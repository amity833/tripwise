# Runs with no keys: fake LLM + in-memory store.
PORT=3000
DEFAULT_TZ=Asia/Jerusalem

# LLM: "fake" (keyword demo, no key) or "gemini"
LLM_PROVIDER=fake
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
DAILY_LLM_CAP=2000

# Demo limits. A user keeps a slot until 24 hours without activity.
MAX_USERS=10
MAX_CONVERSATIONS=5

# Storage: leave empty for in-memory (dev/tests only), or a Postgres URL (Neon)
DATABASE_URL=

# Telegram. Dev: set only the token (polling) and use a SEPARATE dev bot.
# Prod: also set PUBLIC_URL and a webhook secret (webhook mode).
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_URL=
